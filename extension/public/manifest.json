{
  "manifest_version": 3,
  "name": "MeetYou",
  "description": "Bot-free meeting recording and notes for Google Meet.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "notifications",
    "offscreen",
    "sidePanel",
    "storage",
    "tabCapture",
    "unlimitedStorage"
  ],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open MeetYou"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/meet-content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Toggle meeting recording"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "Toggle recording pause"
    }
  }
}
