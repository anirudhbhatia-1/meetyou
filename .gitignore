.env
.env.*
node_modules/
# Never commit meeting audio or real transcripts (AGENTS.md §8)
*.wav
*.mp3
*.m4a
*.opus
*.webm
dist/
coverage/
# Benchmark data, references, and results never go in git (STT_BENCHMARK_PLAN §3.6)
bench-data/
tools/stt-benchmark/results/
tools/stt-benchmark/refs/

# Gateway local chunk storage (real voices during dev; never committed)
backend/apps/gateway/.data/

# Terraform local state, cache, and sensitive variables
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

