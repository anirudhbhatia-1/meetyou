# syntax=docker/dockerfile:1
# Background worker (S2-06): video.finalize needs ffmpeg (ADR-0011 §3.4). STAGING_SETUP §9.
FROM node:24-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/ ./shared/
COPY backend/ ./backend/

RUN pnpm install --frozen-lockfile --prod

ENV NODE_ENV=production
# video.finalize writes its scratch files here.
ENV TMPDIR=/tmp
USER node

EXPOSE 8080

CMD ["node", "backend/apps/worker/src/main.ts"]
