# syntax=docker/dockerfile:1
# Library web app (S4-09): Vite build served by web/server/server.ts, which also proxies /v1 to
# the API (docs/STAGING_SETUP.md §10).
FROM node:24-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY shared/ ./shared/
COPY web/ ./web/
RUN pnpm install --frozen-lockfile --filter @meetyou/web...
RUN pnpm --filter @meetyou/web build

FROM node:24-slim
WORKDIR /app
# The server uses Node built-ins only, so the runtime image needs no node_modules.
COPY --from=build /app/web/dist ./dist
COPY web/server/server.ts ./server.ts
ENV NODE_ENV=production
ENV STATIC_DIR=/app/dist
USER node
EXPOSE 8080
CMD ["node", "server.ts"]
